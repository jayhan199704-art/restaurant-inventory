/** app.wxss */
page {
  min-height: 100%;
  background: linear-gradient(160deg, #d6e8f5, #e8dff0, #f5e8d6);
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  color: #222;
}

:root {
  --primary: #6482f0;
  --text-main: #222;
  --text-secondary: #666;
  --glass-bg: rgba(255, 255, 255, 0.55);
}

.container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
}

.glass-card {
  background: rgba(255,255,255,0.55);
  border: 0.5px solid rgba(255,255,255,0.8);
  border-radius: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.fab-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(14rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 99;
}

.fab-tabbar .item {
  width: 25%;
  text-align: center;
  color: #666;
  font-size: 24rpx;
}

.fab-tabbar .item.active {
  color: #6482f0;
  font-weight: 600;
}

.fab-btn {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: -30rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: none;
  color: #fff;
  background: #6482f0;
  font-size: 56rpx;
  line-height: 100rpx;
  box-shadow: 0 10rpx 28rpx rgba(100, 130, 240, 0.35);
}
