.item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(100, 130, 240, 0.16);
  color: #4a63ca;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.content {
  flex: 1;
  margin-left: 20rpx;
  margin-right: 20rpx;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.right {
  text-align: right;
}

.qty {
  font-size: 40rpx;
  font-weight: 700;
  color: #252525;
}

.status-pill {
  margin-top: 8rpx;
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
}

.status-pill.ok {
  background: #2db56e;
}

.status-pill.low {
  background: #ea4c4c;
}
