.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.add-container {
  position: relative;
  z-index: 2;
  padding-bottom: 120rpx;
}

.halo {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.4;
  z-index: 1;
}

.halo-a {
  width: 300rpx;
  height: 300rpx;
  background: #8cc2ff;
  top: -80rpx;
  left: -40rpx;
}

.halo-b {
  width: 280rpx;
  height: 280rpx;
  background: #c89bff;
  top: 260rpx;
  right: -80rpx;
}

.halo-c {
  width: 240rpx;
  height: 240rpx;
  background: #ffd8a6;
  bottom: 90rpx;
  left: 120rpx;
}

.header-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #4a4a4a;
  margin-right: 18rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
}

.field-card {
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.photo-card {
  min-height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  font-size: 68rpx;
}

.photo-tip {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #666;
}

.preview {
  width: 100%;
  height: 260rpx;
  border-radius: 14rpx;
}

.ai-loading {
  display: flex;
  align-items: center;
  column-gap: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 18rpx;
  color: #4a4a4a;
  font-size: 26rpx;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.field-label {
  font-size: 26rpx;
  color: #444;
}

.ai-tag {
  background: #6482f0;
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
}

.field-input {
  height: 72rpx;
  font-size: 30rpx;
}

.field-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
}

.save-btn {
  margin-top: 18rpx;
  border: none;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #6482f0, #a05adc);
}
