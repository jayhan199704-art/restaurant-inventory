<view class="container">
  <view class="title">统计看板</view>
  <view class="glass-card panel">
    <view>总条目：{{total}}</view>
    <view>低库存：{{lowCount}}</view>
    <view>空库存：{{emptyCount}}</view>
  </view>

  <view class="fab-tabbar">
    <view class="item" bindtap="goHome">首页</view>
    <view class="item active" bindtap="goStats">统计</view>
    <button class="fab-btn" bindtap="goAdd">+</button>
    <view class="item" bindtap="goSettings">设置</view>
  </view>
</view>
